                                <label for="richAdsLimit" class="block text-sm font-medium text-gray-700 mb-1">
                                  RichAds
                                </label>
                                <input type="text" id="richAdsLimit" name="richAdsLimit" value="<%=richAdsLimit%>" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>


                              <div class="mt-4">
                                <label for="adexTraLimit" class="block text-sm font-medium text-gray-700 mb-1">
                                  AdexTra
                                </label>
                                <input type="text" id="adexTraLimit" name="adexTraLimit" value="<%=adexTraLimit%>" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>

                            </div>


                            <div class="space-y-4">

                              <h2 class="text-lg font-bold text-gray-800 mb-5">Withdrawal Settings</h2>

                              <div>
                                <label for="minimumWithdrawal" class="block text-sm font-medium text-gray-700 mb-1 mt-4">
                                  Minimum Withdrawal
                                </label>
                                <input value="<%=minimumWithdrawal%>" type="text" id="minimumWithdrawal" name="minimumWithdrawal" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>

                              <div class="mt-4">
                                <label for="withdrawalFee" class="block text-sm font-medium text-gray-700 mb-1">
                                  Withdrawal Fee
                                </label>
                                <input type="text" id="withdrawalFee" name="withdrawalFee" value="<%=withdrawalFee%>" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>


                              <div class="mt-4">
                                <label for="referToWithdraw" class="block text-sm font-medium text-gray-700 mb-1">
                                  Minimum Refer Count to Withdraw
                                </label>
                                <input type="text" id="referToWithdraw" name="referToWithdraw" value="<%=referToWithdraw%>" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>


                            </div>




                                <div class="space-y-4">

                              <h2 class="text-lg font-bold text-gray-800 mb-5">Tap Settings</h2>

                              <div>
                                <label for="maxTap" class="block text-sm font-medium text-gray-700 mb-1 mt-4">
                                  Max Tap
                                </label>
                                <input value="<%=maxTap%>" type="text" id="maxTap" name="maxTap" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>

                              <div>
                                <label for="tapEarn" class="block text-sm font-medium text-gray-700 mb-1 mt-4">
                                  Tap Earn
                                </label>
                                <input value="<%=tapEarn%>" type="text" id="tapEarn" name="tapEarn" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>


                              <div>
                                <label for="tapInterval" class="block text-sm font-medium text-gray-700 mb-1 mt-4">
                                  Tap Interval in (secs)
                                </label>
                                <input value="<%=tapInterval%>" type="text" id="tapInterval" name="tapInterval" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>

                            </div>


                            <!-- Ad Settings -->
                            <div class="space-y-4">

                              <h2 class="text-lg font-bold text-gray-800 mb-5">Admin Login Credentials</h2>

                              <div>
                                <label for="username" class="block text-sm font-medium text-gray-700 mb-1 mt-4">
                                  Admin Username
                                </label>
                                <input value="<%=username%>" type="text" id="username" name="username" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>

                              <div class="mt-4">
                                <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
                                  Admin Password
                                </label>
                                <input type="text" id="password" name="password" value="" class="w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm p-2 border" />
                              </div>
                            </div>
                          </div>

                          <div class="mt-6 flex justify-end">
                            <button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500">
                              Save Settings
                            </button>
                          </div>
                        </form>
                      </div>
                      <script>
                        // Daily Bonus Tagify (for comma-separated values)
                        new Tagify(document.querySelector('.tagify-bonus'), {
                          pattern: /^\d+$/,
                          delimiters: ",| ",
                          keepInvalidTags: false,
                          dropdown: {
                            enabled: 0 // No dropdown for bonus values
                          },
                          callbacks: {
                            invalid: function(tag) {
                              alert("Only numbers and commas allowed for bonus values");
                            }
                          }
                        });

                        new Tagify(document.getElementById('directLinks'), {
                          delimiters: ",| ",
                          keepInvalidTags: false,
                          dropdown: {
                            enabled: 0 // No dropdown for direct links
                          }
                        });

                        // Admins Tagify (for admin IDs)
                        new Tagify(document.querySelector('.tagify-admins'), {
                          pattern: /^\d+$/,
                          delimiters: ",| ",
                          keepInvalidTags: false,
                          dropdown: {
                            enabled: 0 // No dropdown for admin IDs
                          },
                          callbacks: {
                            invalid: function(tag) {
                              alert("Only numeric admin IDs allowed");
                            }
                          }
                        });
                      </script>
                      <%}%>
        </main>
      </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>


