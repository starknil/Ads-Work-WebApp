<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: "Segoe UI", sans-serif;
      background: linear-gradient(135deg, #f9fafb, #e5e7eb);
      color: #111827;
    }
    .error-box {
      background: white;
      padding: 2rem 3rem;
      border-radius: 12px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.08);
      text-align: center;
      max-width: 400px;
      width: 100%;
    }
    .error-box h1 {
      font-size: 1.75rem;
      margin-bottom: 1rem;
      color: #dc2626;
    }
    .error-box p {
      font-size: 1rem;
      color: #374151;
      margin-bottom: 1.5rem;
    }
    .error-box a {
      display: inline-block;
      padding: 0.6rem 1.2rem;
      font-size: 0.9rem;
      font-weight: 500;
      color: white;
      background: #2563eb;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.2s ease;
    }
    .error-box a:hover {
      background: #1d4ed8;
    }
  </style>
</head>
<body>
  <div class="error-box">
    <h1>Error</h1>
    <p><%= message %></p>
    <a href="javascript:location.reload()">Refresh</a>
  </div>
</body>
</html>